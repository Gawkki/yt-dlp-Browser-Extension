{
  "manifest_version": 3,
  "name": "yt-dlp Bridge",
  "version": "1.1.0",
  "description": "Download the video or audio on the current page with yt-dlp, running locally on your computer.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["nativeMessaging", "activeTab", "storage", "contextMenus", "cookies"],
  "optional_host_permissions": ["*://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "yt-dlp Bridge" },
  "background": { "service_worker": "background.js" }
}
